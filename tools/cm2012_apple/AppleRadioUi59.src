package com.gathin.tvhome;

import android.app.Activity;
import android.content.res.ColorStateList;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.Drawable;
import android.graphics.drawable.GradientDrawable;
import android.view.Gravity;
import android.view.View;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.Switch;
import android.widget.TextView;

/** V5.9 TV readable D-pad radio page. Shared by Wi-Fi and Bluetooth. */
final class AppleRadioUi57 {
    private AppleRadioUi57() { }
    static int dp(Activity a, float v) { return (int)(a.getResources().getDisplayMetrics().density*v + .5f); }
    static GradientDrawable focus(Activity a, boolean selected) {
        GradientDrawable d = new GradientDrawable();
        d.setColor(selected ? 0xFF18395F : 0x0010203B);
        d.setCornerRadius(dp(a, 9));
        d.setStroke(dp(a, selected ? 3 : 1), selected ? 0xFF8CCBFF : 0x0010203B);
        return d;
    }
    /** Distinct large refresh key so it is visible even before focus arrives. */
    static GradientDrawable refreshBackground(Activity a, boolean focused) {
        GradientDrawable d = new GradientDrawable();
        d.setColor(focused ? 0xFF2B5685 : 0xFF1A395F);
        d.setCornerRadius(dp(a, 9));
        d.setStroke(dp(a, focused ? 3 : 2), focused ? 0xFF98D0FF : 0xFF5C82AE);
        return d;
    }
    static LinearLayout page(Activity a) {
        a.getWindow().setStatusBarColor(0xFF07142A);
        a.getWindow().setNavigationBarColor(0xFF07142A);
        ScrollView scroll = new ScrollView(a);
        GradientDrawable bg = new GradientDrawable(GradientDrawable.Orientation.TL_BR,
                new int[]{0xFF071428,0xFF0D2750,0xFF0B367B});
        scroll.setBackground(bg);
        scroll.setFillViewport(true);
        LinearLayout outer = new LinearLayout(a);
        outer.setOrientation(LinearLayout.VERTICAL);
        outer.setGravity(Gravity.TOP | Gravity.CENTER_HORIZONTAL);
        outer.setPadding(dp(a, 14), dp(a, 26), dp(a, 14), dp(a, 32));
        scroll.addView(outer);
        LinearLayout body = new LinearLayout(a);
        body.setOrientation(LinearLayout.VERTICAL);
        int screenWidth = a.getResources().getDisplayMetrics().widthPixels;
        int width = Math.min(dp(a, 1250), Math.max(dp(a, 280), screenWidth * 88 / 100));
        outer.addView(body, new LinearLayout.LayoutParams(width, -2));
        a.setContentView(scroll);
        return body;
    }
    static final class Toggle {
        final LinearLayout row;
        final Switch toggle;
        Toggle(LinearLayout r, Switch s) { row=r; toggle=s; }
        void setOn(boolean on) { toggle.setChecked(on); }
        void action(Runnable run) { row.setOnClickListener(v -> run.run()); }
    }
    static Toggle switchRow(Activity a, LinearLayout parent, String title) {
        return switchRow(a, parent, title, null);
    }
    /** V5.8: Focusable manual refresh beside the switch, no extra search screen. */
    static Toggle switchRow(Activity a, LinearLayout parent, String title, Runnable manualRefresh) {
        LinearLayout header = new LinearLayout(a);
        header.setOrientation(LinearLayout.HORIZONTAL);
        header.setGravity(Gravity.CENTER_VERTICAL);
        parent.addView(header, new LinearLayout.LayoutParams(-1, dp(a, 72)));
        LinearLayout row = new LinearLayout(a);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setGravity(Gravity.CENTER_VERTICAL);
        row.setPadding(dp(a, 16), dp(a, 6), dp(a, 20), dp(a, 6));
        row.setMinimumHeight(dp(a, 68));
        row.setFocusable(true);
        row.setClickable(true);
        row.setBackground(focus(a, false));
        row.setOnFocusChangeListener((v, f) -> row.setBackground(focus(a, f)));
        header.addView(row, new LinearLayout.LayoutParams(0, dp(a, 68), 1f));
        TextView name = new TextView(a);
        name.setText(title);
        name.setTextSize(23);
        name.setTextColor(Color.WHITE);
        row.addView(name, new LinearLayout.LayoutParams(0, -2, 1f));
        Switch s = new Switch(a);
        s.setFocusable(false);
        s.setScaleX(1.30f);
        s.setScaleY(1.30f);
        s.setClickable(false);
        s.setThumbTintList(new ColorStateList(new int[][]{new int[]{android.R.attr.state_checked}, new int[]{}},
                new int[]{0xFFFFFFFF,0xFF8D9BB0}));
        s.setTrackTintList(new ColorStateList(new int[][]{new int[]{android.R.attr.state_checked}, new int[]{}},
                new int[]{0xFF21BC67,0xFF566579}));
        row.addView(s, new LinearLayout.LayoutParams(dp(a, 80), dp(a, 54)));
        if (manualRefresh != null) {
            TextView refresh = new TextView(a);
            refresh.setText("刷新");
            refresh.setTextSize(20);
            refresh.setTextColor(Color.WHITE);
            refresh.setGravity(Gravity.CENTER);
            refresh.setContentDescription("手动刷新" + title + "列表");
            refresh.setFocusable(true);
            refresh.setClickable(true);
            refresh.setBackground(refreshBackground(a, false));
            refresh.setOnFocusChangeListener((v, f) -> refresh.setBackground(refreshBackground(a, f)));
            LinearLayout.LayoutParams refreshLp = new LinearLayout.LayoutParams(dp(a, 104), dp(a, 68));
            refreshLp.leftMargin = dp(a, 14);
            header.addView(refresh, refreshLp);
            refresh.setOnClickListener(v -> manualRefresh.run());
        }
        return new Toggle(row, s);
    }
    static final class Row {
        final LinearLayout root;
        Row(LinearLayout v) { root=v; }
        void action(Runnable r) { root.setOnClickListener(v -> r.run()); }
    }
    static Row item(Activity a, LinearLayout parent, String name, String badge, Drawable signal, boolean selected) {
        LinearLayout row = new LinearLayout(a);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setGravity(Gravity.CENTER_VERTICAL);
        row.setPadding(dp(a, 18), dp(a, 10), dp(a, 17), dp(a, 10));
        row.setMinimumHeight(dp(a, 64));
        row.setFocusable(true);
        row.setClickable(true);
        row.setBackground(focus(a, false));
        row.setOnFocusChangeListener((v, focused) -> row.setBackground(focus(a, focused)));
        parent.addView(row, new LinearLayout.LayoutParams(-1, dp(a, 64)));
        TextView title = new TextView(a);
        title.setText(name);
        title.setTextSize(22);
        title.setSingleLine(true);
        title.setEllipsize(android.text.TextUtils.TruncateAt.END);
        title.setTextColor(selected ? 0xFF31E57C : 0xFFF3F6FC);
        row.addView(title, new LinearLayout.LayoutParams(0, -2, 1f));
        TextView info = new TextView(a);
        info.setText(badge);
        info.setTextSize(18);
        info.setTextColor(selected ? 0xFF31E57C : 0xFFB1C1D5);
        info.setGravity(Gravity.CENTER_VERTICAL);
        if (signal != null) {
            signal.setBounds(0, 0, dp(a, 32), dp(a, 32));
            info.setCompoundDrawablesRelative(null, null, signal, null);
            info.setCompoundDrawablePadding(dp(a, 11));
        }
        row.addView(info, new LinearLayout.LayoutParams(-2, -2));
        return new Row(row);
    }
    static TextView hint(Activity a, LinearLayout parent) {
        TextView t = new TextView(a);
        t.setTextSize(17);
        t.setTextColor(0xFF96AFCF);
        t.setPadding(dp(a, 16), dp(a, 16), dp(a, 16), dp(a, 8));
        parent.addView(t);
        return t;
    }
}